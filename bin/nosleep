#!/usr/bin/env python3
"""Launch the standalone Nightr monitor without shell startup files."""
import os
from pathlib import Path
import sys
import stat
import subprocess


def installed_native():
    """Use only the canonical signed, root-owned app, never PATH or a worktree."""
    if sys.platform != "darwin" or os.environ.get("NIGHTR_TEST_NO_NATIVE") == "1":
        return None
    app = Path("/Applications/Nightr.app")
    binary = app / "Contents/MacOS/nightr-native"
    if not app.exists() and Path("/Library/Application Support/Nightr/update.lock").exists():
        raise RuntimeError("Nightr installation is being updated or needs repair; retry after setup")
    seen_app = False
    try:
        for path in (app, app / "Contents", app / "Contents/MacOS", binary):
            info = path.lstat()
            seen_app = True
            if info.st_uid != 0 or info.st_mode & 0o022 or stat.S_ISLNK(info.st_mode):
                raise RuntimeError("canonical Nightr app has unsafe ownership; repair the installation")
        checked = subprocess.run(["/usr/bin/codesign", "--verify", "--strict", str(app)],
                                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, timeout=10)
        if checked.returncode:
            raise RuntimeError("canonical Nightr signature is invalid; repair the installation")
        return binary
    except FileNotFoundError:
        if seen_app:
            raise RuntimeError("canonical Nightr app is incomplete; repair the installation") from None
        return None


def main():
    native = installed_native()
    if native is not None:
        os.execv(str(native), [str(native), *sys.argv[1:]])
        return
    root = Path(__file__).resolve().parent.parent
    os.execvp("zsh", ["zsh", "-f", "-c",
                     'source "$1/zsh/nosleep.zsh" || exit; shift; nosleep "$@"',
                     "nosleep", str(root), *sys.argv[1:]])


if __name__ == "__main__":
    sys.exit(main())
